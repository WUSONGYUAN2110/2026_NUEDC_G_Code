// Bootgen image template for ZYNQ QSPI boot.
// vitis/run.tcl boot and vitis/program-qspi.ps1 stage the real files under vitis/boot/.
// BOOT.bin is generated by vitis/run.tcl. Do not edit it manually; generated delivery
// artifacts are ignored according to the repository policy in AGENTS.md and .gitignore.
the_ROM_image:
{
    [bootloader] boot/fsbl.elf
    boot/system.bit
    boot/application.elf
}
